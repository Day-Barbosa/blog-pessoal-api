# Copie este arquivo para .env e ajuste os valores. O .env não é versionado.

# --- Banco de dados (perfil dev / docker compose) ---
DB_USERNAME=root
DB_PASSWORD=root

# --- Produção (perfil prod, ex.: Render) ---
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
# SPRING_DATASOURCE_USERNAME=<usuario>
# SPRING_DATASOURCE_PASSWORD=<senha>

# --- JWT ---
# Chave Base64 com 256+ bits. Gere com: openssl rand -base64 32
# Sem ela, a API usa uma chave de desenvolvimento (não use em produção).
# JWT_SECRET=
